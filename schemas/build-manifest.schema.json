{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Witnessability/witnessability-model/schemas/build-manifest.schema.json",
  "title": "Build manifest",
  "description": "Records one build: the exact inputs, the exact toolchain, the exact environment, and the exact output. It is evidence about a single build and never, by itself, a reproducibility claim.",
  "type": "object",
  "required": ["schema", "generated_at", "source", "toolchain", "environment", "build", "output", "claims"],
  "additionalProperties": false,

  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "file_digest": {
      "type": "object",
      "required": ["bytes", "sha256"],
      "additionalProperties": false,
      "properties": {
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  },

  "properties": {
    "schema": { "type": "string" },
    "generated_at": { "type": "string", "format": "date-time" },

    "source": {
      "type": "object",
      "required": ["git_commit", "git_tree", "working_tree_dirty", "files"],
      "properties": {
        "git_commit": { "type": "string" },
        "git_tree": { "type": "string" },
        "git_branch": { "type": "string" },
        "working_tree_dirty": {
          "type": "boolean",
          "description": "A build from a dirty tree cannot be tied to a commit. True here disqualifies the build from becoming a release artifact."
        },
        "files": {
          "type": "object",
          "description": "Every source file that entered the build, keyed by repository path.",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/file_digest" }
        }
      }
    },

    "toolchain": {
      "type": "object",
      "required": ["image_ref", "engine"],
      "properties": {
        "image_ref": { "type": "string" },
        "image_index_digest": { "type": "string" },
        "platform_digest": { "type": "string" },
        "engine": { "enum": ["xelatex", "pdflatex", "lualatex"] },
        "tex_live_version": { "type": "string" },
        "engine_version": { "type": "string" },
        "latexmk_version": { "type": "string" },
        "bib_tool": { "type": "string" },
        "fonts": { "type": "object" }
      }
    },

    "environment": {
      "type": "object",
      "required": ["build_platform", "source_date_epoch", "timestamp_policy"],
      "properties": {
        "build_platform": { "type": "string", "examples": ["linux/amd64", "linux/arm64"] },
        "source_date_epoch": { "type": "integer" },
        "timestamp_policy": { "type": "string" },
        "tz": { "type": "string" },
        "locale": { "type": "string" },
        "container_workdir": { "type": "string" },
        "host_paths_in_output": { "type": "string" }
      }
    },

    "build": {
      "type": "object",
      "required": ["command"],
      "properties": {
        "command": { "type": "string" },
        "container_command": { "type": "string" }
      }
    },

    "output": {
      "type": "object",
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": { "type": "string" },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },

    "claims": {
      "type": "object",
      "required": ["released"],
      "properties": {
        "released": {
          "const": false,
          "description": "A build output is never a release. This field is const-false by design: promoting a build to a release happens in releases/, under an authorized release, not by editing a build manifest."
        },
        "reproducibility_proven": { "type": "string" },
        "note": { "type": "string" }
      }
    }
  }
}
